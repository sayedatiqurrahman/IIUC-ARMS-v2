    "postinstall": "prisma generate && node -e \"const fs=require('fs');const p='node_modules/@pdftron/pdfjs-express/public';if(fs.existsSync(p)){fs.cpSync(p,'public/webviewer/lib',{recursive:true,force:true})}const o='node_modules/@techstark/opencv-js/dist/opencv.js';if(fs.existsSync(o)){fs.mkdirSync('public',{recursive:true});fs.copyFileSync(o,'public/opencv.js')}\"",
    "db:migrate": "node scripts/fix-profile-columns.js"
  },
