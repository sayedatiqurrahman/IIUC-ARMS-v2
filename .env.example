GITHUB_ID=your_github_oauth_app_id
GITHUB_SECRET=your_github_oauth_app_secret
NEXTAUTH_SECRET=generate_a_random_secret_here
NEXTAUTH_URL=http://localhost:3000
# On Vercel: set NEXTAUTH_URL=https://your-domain.com in project settings

# GitHub App (bot) — used to auto-merge uploads / commit to the file-storage
# repo with NO manual approval. The App must be installed on the storage repo.
#   GITHUB_APP_ID     = the numeric App ID of the GitHub App (NOT the OAuth
#                       client id above — those are different values)
#   GITHUB_PRIVATE_KEY = the App's private key (.pem), with \n for newlines
# Optional: GITHUB_TOKEN = a PAT of a collaborator with repo write access
# (used as a fallback server token when the App isn't configured).
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_TOKEN=

# Firebase (client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET=your_turnstile_secret

# Adobe PDF Embed
NEXT_PUBLIC_ADOBE_CLIENT_ID=your_adobe_client_id

# Database (Turso/libSQL)
DATABASE_URL=file:./prisma/dev.db
DATABASE_URL=libsql://your-db-name-your-org.turso.io
DATABASE_AUTH_TOKEN=your_turso_auth_token

# Telegram bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_CHANNEL_ID=your_channel_id_or_@username
TELEGRAM_GROUP_ID=your_group_chat_id
# Owner's Telegram chat id (used to authorize destructive bot actions)
TELEGRAM_OWNER_CHAT_ID=0
# Optional: a dedicated secret to authenticate Telegram webhook updates.
# If unset, the bot token is used as the webhook secret automatically.
TELEGRAM_BOT_WEBHOOK_SECRET=generate_a_random_secret_here

# Optional: CRON_SECRET for scheduled tasks (e.g. notice cleanup)
CRON_SECRET=
