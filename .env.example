# ═══════════════════════════════════════════════════════════════════════
# IIUC-ARMS v2 — Environment Variables
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.
#
# FOR CONTRIBUTORS:
# - Most features work WITHOUT Telegram, Turnstile, or Adobe keys
# - You need: Firebase, Database, and GitHub tokens at minimum
# - Preview deployments on Vercel auto-set DATABASE_URL from the project
# ═══════════════════════════════════════════════════════════════════════

# ── Site URL ──
NEXT_PUBLIC_SITE_URL=https://iiuc-arms.eu.cc

# ── Database (required) ──
# For local dev, use: file:./prisma/dev.db
# For Turso (production): libsql://your-db.turso.io
DATABASE_URL=file:./prisma/dev.db
DATABASE_AUTH_TOKEN=

# ── Firebase Auth (required) ──
# Get from Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server-side)
# Get from Firebase Console > Project Settings > Service Accounts
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PROJECT_ID=

# ── NextAuth ──
NEXTAUTH_SECRET=your-random-secret-here
NEXTAUTH_URL=http://localhost:3000

# ── GitHub (required for file uploads, club data, etc.) ──
# Option A: GitHub App (recommended for production)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
# Option B: Personal Access Token (simpler for dev)
GITHUB_TOKEN=

# ── Telegram (optional — app works without it) ──
# Only needed for broadcast notifications, OTP verification
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_ID=
TELEGRAM_GROUP_ID=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_BOT_WEBHOOK_SECRET=

# ── Security / Captcha (optional) ──
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── PDF Embed (optional) ──
NEXT_PUBLIC_ADOBE_CLIENT_ID=

# ── Cron Jobs (only on Vercel) ──
CRON_SECRET=

# ── Encryption (optional) ──
TOKEN_ENCRYPTION_KEY=
