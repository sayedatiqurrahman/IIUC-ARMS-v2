generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
}

model Profile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  email                String?
  name                 String?
  universityId         String?
  whatsapp             String?
  semester             String?
  image                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  facebook             String?
  githubLogin          String?
  hideUniversityId     Boolean  @default(false)
  hideWhatsapp         Boolean  @default(false)
  linkedin             String?
  twitter              String?
  website              String?
  githubToken          String?
  company              String?
  companyUrl           String?
  hideEmail            Boolean  @default(false)
  hideSemester         Boolean  @default(false)
  publicEmail          String?
  githubInstallationId String?
  githubAvatar         String?
  role                 String?  @default("user")
  totpEnabled          Boolean  @default(false)
  totpSecret           String?
  title                String?
  isBanned             Boolean? @default(false)
  shortForm            String?
  department           String?
  isCR                 Boolean? @default(false)
  isACR                Boolean  @default(false)
  section              String?
  totpMethods          String[] @default(["email"])
  hideCompany          Boolean? @default(false)
  banReason            String?
  bannedBy             String?
  customPermissions    Json?    @default("{}")
  phone                String?
   telegramId           String?
  batchId              String?
  telegramChatId       String?
  session              String?
   telegramVerified     Boolean? @default(false)
   telegramOtp          String?
   telegramOtpExpiresAt DateTime?
   telegramConnectState String?
   linkedEmails         String[] @default([])
  showInContributors   Boolean? @default(true)
  accountStatus        String?  @default("active")
  profileType          String?  @default("")

  @@index([githubLogin])
  @@index([email])
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  userId    String
  userName  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model FacultyMember {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  department String
  name       String
  title      String?
  email      String?
  phone      String?
  shortForm  String?
  memberType String   @default("faculty")
  isCR       Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  isVisible  Boolean  @default(false)
}

model Course {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  department String
  semester   String
  code       String
  title      String
  addedBy    String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([department, semester, code])
  @@index([department])
  @@index([semester])
}

// Temporary storage for large-file uploads. The client splits files bigger
// than a few MB into chunks (each request stays under Vercel's 4.5MB body
// limit), stores them here, then finalizes into a single git commit.
model UploadChunk {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  path      String
  index     Int
  total     Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([sessionId, userId])
  @@index([userId])
  @@index([createdAt])
}

model SiteSettings {
  id                 String   @id @default("site-settings")
  permissions        Json     @default("{}")
  updatedAt          DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  extraDepartments   Json?    @default("{}")
  customFaculties    Json?    @default("[]")
  contributorSettings Json?
  blockedTelegramChats     Json? @default("[]")
  blockedTelegramUsernames Json? @default("[]")
  customRoles              Json? @default("[]")
  broadcastTargets         Json? @default("[]")
}

model SemesterCourse {
  id        String   @id @default(cuid())
  semester  String
  code      String
  title     String
  teacher   String?
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([semester, code])
  @@index([semester])
}

model PublishedRoutine {
  id            String   @id @default(cuid())
  routineId     String
  semester      String
  session       String?
  branch        String?
  gender        String?
  academicYear  String?
  department    String?
  university    String?
  room          String?
  periods       Json
  days          Json
  courses       Json
  slots         Json
  malePeriods   Json?
  femalePeriods Json?
  maleSlots     Json?
  femaleSlots   Json?
  publishedBy   String?
  publishedAt   DateTime @default(now())
  expiresAt     DateTime
  status        String   @default("published")
  scheduledAt   DateTime?

  @@index([routineId])
  @@index([semester])
  @@index([expiresAt])
  @@index([status])
}

model FacultyRequest {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  requesterId String
  department  String
  name        String
  title       String?
  email       String?
  phone       String?
  shortForm   String?
  memberType  String    @default("faculty")
  notes       String?
  status      String    @default("pending")
  reviewedBy  String?
  reviewedAt  DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  @@index([requesterId])
  @@index([status])
  @@index([department])
}

model PublishedExamRoutine {
  id               String   @id @default(dbgenerated("gen_random_uuid()"))
  examId           String
  semester         String
  session          String?
  department       String?
  examType         String?
  type             String?
  rows             Json
  slots            Json
  publishedBy      String?
  publishedByEmail String?
  publishedAt      DateTime @default(now()) @db.Timestamptz(6)
  expiresAt        DateTime @db.Timestamptz(6)
  status           String   @default("published")
  scheduledAt      DateTime?

  @@index([examId])
  @@index([semester])
  @@index([department])
  @@index([expiresAt])
  @@index([status])
}

model Room {
  id              String   @id @default(cuid())
  department      String
  name            String
  capacity        Int      @default(40)
  gender          String   @default("both")
  building        String?
  floor           String?
  numberOfColumns Int?
  chairsPerColumn Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([department, name])
  @@index([department])
}

model Batch {
  id              String   @id @default(cuid())
  department      String
  name            String
  session         String
  startSemester   String   @default("1st-semister")
  currentSemester String   @default("1st-semister")
  startDate       DateTime @default(now())
  targetEndDate   DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([department])
}

model BatchStudent {
  id            String   @id @default(cuid())
  batchId       String
  email         String
  universityId  String
  originalId    String?
  name          String?
  isReAdmission Boolean  @default(false)

  @@unique([batchId, universityId])
  @@index([batchId])
  @@index([email])
}

model TelegramNotification {
  id             String   @id @default(cuid())
  department     String
  type           String
  title          String
  message        String
  sentBy         String?
  recipientCount Int      @default(0)
  sentAt         DateTime @default(now())

  @@index([department])
  @@index([sentAt])
}
