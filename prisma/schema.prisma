generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
}

model Profile {
  id            String  @id @default(cuid())
  userId        String  @unique
  email         String?
  name          String?
  universityId  String?
  whatsapp      String?
  semester      String?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
