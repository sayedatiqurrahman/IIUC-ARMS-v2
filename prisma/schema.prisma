generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  email           String?
  name            String?
  title           String?
  shortForm       String?
  department      String?
  section         String?
  isCR            Boolean  @default(false)
  isACR           Boolean  @default(false)
  universityId    String?
  whatsapp        String?
  semester        String?
  image           String?
  role            String?  @default("user")
  isBanned        Boolean  @default(false)
  banReason        String?
  bannedBy        String?
  githubLogin     String?
  githubToken     String?
  githubInstallationId String?
  githubAvatar    String?
  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  totpMethods     String[] @default(["email"])
  facebook        String?
  twitter         String?
  linkedin        String?
  website         String?
  company         String?
  companyUrl      String?
  publicEmail     String?
  hideWhatsapp    Boolean  @default(false)
  hideUniversityId Boolean @default(false)
  hideSemester    Boolean  @default(false)
  hideEmail       Boolean  @default(false)
  hideCompany     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([githubLogin])
  @@index([email])
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  userId    String
  userName  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model FacultyMember {
  id          String   @id @default(cuid())
  department  String
  name        String
  title       String?
  email       String?
  phone       String?
  shortForm   String?
  memberType  String   @default("faculty")
  isCR        Boolean  @default(false)
  isVisible   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([department])
  @@index([email])
  @@index([name])
}

model Course {
  id          String   @id @default(cuid())
  department  String
  semester    String
  code        String
  title       String
  addedBy     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([department])
  @@index([semester])
  @@unique([department, semester, code])
}

model SiteSettings {
  id                  String   @id @default("site-settings")
  permissions         Json     @default("{}")
  contributorSettings Json     @default("{}")
  updatedAt           DateTime @updatedAt
}

model SemesterCourse {
  id          String   @id @default(cuid())
  semester    String
  code        String
  title       String
  teacher     String?
  room        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([semester])
  @@unique([semester, code])
}

model PublishedRoutine {
  id            String   @id @default(cuid())
  routineId     String
  semester      String
  session       String?
  branch        String?
  gender        String?
  academicYear  String?
  department    String?
  university    String?
  room          String?
  periods       Json
  days          Json
  courses       Json
  slots         Json
  malePeriods   Json?
  femalePeriods Json?
  maleSlots     Json?
  femaleSlots   Json?
  publishedBy   String?
  publishedAt   DateTime @default(now())
  expiresAt     DateTime

  @@index([routineId])
  @@index([semester])
  @@index([expiresAt])
}

model FacultyRequest {
  id          String   @id @default(cuid())
  requesterId String
  department  String
  name        String
  title       String?
  email       String?
  phone       String?
  shortForm   String?
  memberType  String   @default("faculty")
  notes       String?
  status      String   @default("pending")
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([requesterId])
  @@index([status])
  @@index([department])
}
