generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Profile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  email                String?
  name                 String?
  universityId         String?
  whatsapp             String?
  semester             String?
  image                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  facebook             String?
  githubLogin          String?
  hideUniversityId     Boolean   @default(false)
  hideWhatsapp         Boolean   @default(false)
  linkedin             String?
  twitter              String?
  website              String?
  githubToken          String?
  company              String?
  companyUrl           String?
  hideEmail            Boolean   @default(false)
  hideSemester         Boolean   @default(false)
  publicEmail          String?
  githubInstallationId String?
  githubAvatar         String?
  role                 String?   @default("user")
  totpEnabled          Boolean   @default(false)
  totpSecret           String?
  title                String?
  isBanned             Boolean?  @default(false)
  shortForm            String?
  department           String?
  isCR                 Boolean?  @default(false)
  isACR                Boolean   @default(false)
  section              String?
  totpMethods          String    @default("[\"email\"]")
  hideCompany          Boolean?  @default(false)
  hideFacebook         Boolean?  @default(false)
  hideTwitter          Boolean?  @default(false)
  hideLinkedin         Boolean?  @default(false)
  hideWebsite          Boolean?  @default(false)
  banReason            String?
  bannedBy             String?
  customPermissions    Json?     @default("{}")
  telegramId           String?
  batchId              String?
  telegramChatId       String?
  session              String?
  telegramVerified     Boolean?  @default(false)
  telegramOtp          String?
  telegramOtpExpiresAt DateTime?
  telegramConnectState String?
  linkedEmails         String    @default("[]")
  showInContributors   Boolean?  @default(true)
  accountStatus        String?   @default("active")
  profileType          String?   @default("")

  @@index([githubLogin])
  @@index([email])
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  userId    String
  userName  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model FacultyMember {
  id         String   @id @default(cuid())
  department String
  name       String
  title      String?
  email      String?
  phone      String?
  shortForm  String?
  memberType String   @default("faculty")
  isCR       Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  isVisible  Boolean  @default(false)
  claimedBy  String?
  @@index([claimedBy])
}

model Course {
  id         String   @id @default(cuid())
  department String
  semester   String
  code       String
  title      String
  addedBy    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([department, semester, code])
  @@index([department])
  @@index([semester])
}

// Temporary storage for large-file uploads. The client splits files bigger
// than a few MB into chunks (each request stays under Vercel's 4.5MB body
// limit), stores them here, then finalizes into a single git commit.
model UploadChunk {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  path      String
  index     Int
  total     Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([sessionId, userId])
  @@index([userId])
  @@index([createdAt])
}

model SiteSettings {
  id                       String   @id @default("site-settings")
  permissions              Json     @default("{}")
  updatedAt                DateTime @default(now()) @updatedAt
  extraDepartments         Json?    @default("{}")
  customFaculties          Json?    @default("[]")
  contributorSettings      Json?
  blockedTelegramChats     Json?    @default("[]")
  blockedTelegramUsernames Json?    @default("[]")
  customRoles              Json?    @default("[]")
  broadcastTargets         Json?    @default("[]")
  customClubRoles          Json?    @default("[]")
  supportConfig            Json?
  postingChannels          Json?
  telegramChats            Json?
}

model SemesterCourse {
  id        String   @id @default(cuid())
  semester  String
  code      String
  title     String
  teacher   String?
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([semester, code])
  @@index([semester])
}

model PublishedRoutine {
  id            String    @id @default(cuid())
  routineId     String
  semester      String
  session       String?
  branch        String?
  gender        String?
  academicYear  String?
  department    String?
  university    String?
  room          String?
  periods       Json
  days          Json
  courses       Json
  slots         Json
  malePeriods   Json?
  femalePeriods Json?
  maleSlots     Json?
  femaleSlots   Json?
  publishedBy   String?
  publishedAt   DateTime  @default(now())
  expiresAt     DateTime
  status        String    @default("published")
  scheduledAt   DateTime?

  @@index([routineId])
  @@index([semester])
  @@index([expiresAt])
  @@index([status])
}

model FacultyRequest {
  id          String    @id @default(cuid())
  requesterId String
  department  String
  name        String
  title       String?
  email       String?
  phone       String?
  shortForm   String?
  memberType  String    @default("faculty")
  notes       String?
  status      String    @default("pending")
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([requesterId])
  @@index([status])
  @@index([department])
}

model PublishedExamRoutine {
  id               String    @id @default(cuid())
  examId           String
  semester         String
  session          String?
  department       String?
  examType         String?
  type             String?
  rows             Json
  slots            Json
  publishedBy      String?
  publishedByEmail String?
  publishedAt      DateTime  @default(now())
  expiresAt        DateTime
  status           String    @default("published")
  scheduledAt      DateTime?

  @@index([examId])
  @@index([semester])
  @@index([department])
  @@index([expiresAt])
  @@index([status])
}

model Room {
  id              String   @id @default(cuid())
  department      String
  name            String
  capacity        Int      @default(40)
  gender          String   @default("both")
  building        String?
  floor           String?
  numberOfColumns Int?
  chairsPerColumn Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@unique([department, name])
  @@index([department])
}

model Batch {
  id              String   @id @default(cuid())
  department      String
  name            String
  session         String
  idRange         String?
  startSemester   String   @default("1st-semister")
  currentSemester String   @default("1st-semister")
  isGraduated     Boolean  @default(false)
  startDate       DateTime @default(now())
  targetEndDate   DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([department])
}

model BatchStudent {
  id            String  @id @default(cuid())
  batchId       String
  email         String
  universityId  String
  originalId    String?
  name          String?
  isReAdmission Boolean @default(false)

  @@unique([batchId, universityId])
  @@index([batchId])
  @@index([email])
}

model TelegramNotification {
  id             String   @id @default(cuid())
  department     String
  type           String
  title          String
  message        String
  sentBy         String?
  recipientCount Int      @default(0)
  sentAt         DateTime @default(now())

  @@index([department])
  @@index([sentAt])
}

// ─── Club System ─────────────────────────────────────────────────────────────

model Club {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  department  String
  description String?
  logoUrl     String?
  coverUrl    String?
  createdBy   String
  settings    String?  // JSON: { managerCanManageMembers, managerCanIssueCerts, managerCanManageEvents }
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ClubMember[]
  events      ClubEvent[]
  certificates ClubCertificate[]
  claims      ClubClaim[]

  @@index([department])
  @@index([slug])
}

model ClubMember {
  id                   String   @id @default(cuid())
  clubId               String
  userId               String
  role                 String   @default("member") // gs, ags, ogs, office_secretary, member
  clubRoles            String?  // JSON array: ["club_admin","club_maintainer","club_event_manager","club_cert_issuer"]
  isClubAdmin          Boolean  @default(false) // creator gets this; super-powers within the club
  assignedBy           String?
  previousRole         String?
  previousRoleSession  String?
  createdAt            DateTime @default(now())

  club       Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
}

model ClubEvent {
  id          String   @id @default(cuid())
  clubId      String
  title       String
  description String?
  eventDate   DateTime?
  venue       String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([eventDate])
}

model ClubCertificate {
  id            String   @id @default(cuid())
  certificateId String   @unique
  clubId        String
  eventId       String?
  memberName    String
  universityId  String
  department    String
  session       String?
  post          String?
  eventName     String?
  servicePeriod String?
  signatories   String?  // JSON: [{name, designation, title}]
  issuedBy      String
  issuedAt      DateTime @default(now())

  club          Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([certificateId])
  @@index([universityId])
}

model ClubClaim {
  id          String   @id @default(cuid())
  clubId      String
  userId      String
  requestedRole String  @default("member")
  message     String?
  status      String   @default("pending") // pending | approved | rejected
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())

  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([clubId])
  @@index([userId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════
// Certificate Studio — standalone certificate generation under orgs
// ═══════════════════════════════════════════════════════════════════════

model StudioOrganization {
  id          String   @id @default(cuid())
  name        String                       // e.g. "CSE Batch 2024"
  slug        String   @unique             // URL-safe: "cse-batch-2024"
  type        String   @default("batch")   // batch | society | department | event | custom
  logoUrl     String?
  description String?
  createdBy   String                       // email of creator
  memberCount Int      @default(0)
  certCount   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  certificates StudioCertificate[]

  @@index([slug])
  @@index([createdBy])
}

model StudioCertificate {
  id            String   @id @default(cuid())
  certificateId String   @unique          // e.g. "IIUC-XKMR-B572-ETGQ"
  orgId         String
  memberName    String
  universityId  String
  department    String
  session       String?
  post          String?                   // role / designation
  eventName     String?                   // event name
  servicePeriod String?                   // e.g. "2024-2025"
  signatories   String?                   // JSON: [{name, designation, title}]
  issuedBy      String                    // email of issuer
  issuedAt      DateTime @default(now())

  org           StudioOrganization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([certificateId])
  @@index([universityId])
}
