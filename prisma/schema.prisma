generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  email           String?
  name            String?
  universityId    String?
  whatsapp        String?
  semester        String?
  image           String?
  githubLogin     String?
  githubToken     String?
  facebook        String?
  twitter         String?
  linkedin        String?
  website         String?
  hideWhatsapp    Boolean  @default(false)
  hideUniversityId Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([githubLogin])
  @@index([email])
}
