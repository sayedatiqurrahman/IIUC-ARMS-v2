generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  email           String?
  name            String?
  title           String?
  shortForm       String?
  department      String?
  section         String?
  isCR            Boolean  @default(false)
  isACR           Boolean  @default(false)
  universityId    String?
  whatsapp        String?
  phone           String?
  telegramId      String?
  semester        String?
  image           String?
  role            String?  @default("user")
  batchId         String?
  isBanned        Boolean  @default(false)
  banReason       String?
  bannedBy        String?
  githubLogin     String?
  githubToken     String?
  githubInstallationId String?
  githubAvatar    String?
  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  totpMethods     String[] @default(["email"])
  facebook        String?
  twitter         String?
  linkedin        String?
  website         String?
  company         String?
  companyUrl      String?
  publicEmail     String?
  hideWhatsapp    Boolean @default(false)
  hideUniversityId Boolean @default(false)
  hideSemester    Boolean @default(false)
  hideEmail       Boolean @default(false)
  hideCompany     Boolean @default(false)
  customPermissions Json?  @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([githubLogin])
  @@index([email])
  @@index([batchId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  userId    String
  userName  String?
  details   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model FacultyMember {
  id          String   @id @default(cuid())
  department  String
  name        String
  title       String?
  email       String?
  phone       String?
  shortForm   String?
  memberType  String   @default("faculty")
  isCR        Boolean  @default(false)
  isVisible   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([department])
  @@index([email])
  @@index([name])
}

model Course {
  id          String   @id @default(cuid())
  department  String
  semester    String
  code        String
  title       String
  addedBy     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([department])
  @@index([semester])
  @@unique([department, semester, code])
}

model SiteSettings {
  id                  String   @id @default("site-settings")
  permissions         Json     @default("{}")
  contributorSettings Json     @default("{}")
  customFaculties     Json     @default("[]")
  updatedAt           DateTime @updatedAt
}

model SemesterCourse {
  id          String   @id @default(cuid())
  semester    String
  code        String
  title       String
  teacher     String?
  room        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([semester])
  @@unique([semester, code])
}

model PublishedRoutine {
  id            String   @id @default(cuid())
  routineId     String
  semester      String
  session       String?
  branch        String?
  gender        String?
  academicYear  String?
  department    String?
  university    String?
  room          String?
  periods       Json
  days          Json
  courses       Json
  slots         Json
  malePeriods   Json?
  femalePeriods Json?
  maleSlots     Json?
  femaleSlots   Json?
  publishedBy   String?
  publishedAt   DateTime @default(now())
  expiresAt     DateTime

  @@index([routineId])
  @@index([semester])
  @@index([expiresAt])
}

model FacultyRequest {
  id          String   @id @default(cuid())
  requesterId String
  department  String
  name        String
  title       String?
  email       String?
  phone       String?
  shortForm   String?
  memberType  String   @default("faculty")
  notes       String?
  status      String   @default("pending")
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([requesterId])
  @@index([status])
  @@index([department])
}

model PublishedExamRoutine {
  id            String   @id @default(cuid())
  examId        String
  semester      String
  session       String?
  department    String?
  examType      String?
  type          String?
  rows          Json
  slots         Json
  status        String   @default("published")
  publishedBy   String?
  publishedByEmail String?
  publishedAt   DateTime @default(now())
  expiresAt     DateTime

  @@index([examId])
  @@index([semester])
  @@index([department])
  @@index([status])
  @@index([type])
  @@index([expiresAt])
}

model Room {
  id                String   @id @default(cuid())
  department        String
  name              String
  capacity          Int      @default(40)
  gender            String   @default("both")
  building          String?
  floor             String?
  numberOfColumns   Int?
  chairsPerColumn   Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([department])
  @@unique([department, name])
}

model Batch {
  id              String   @id @default(cuid())
  department      String
  name            String
  session         String
  startSemester   String   @default("1st-semister")
  currentSemester String   @default("1st-semister")
  startDate       DateTime @default(now())
  targetEndDate   DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([department])
  @@index([isActive])
}

model BatchStudent {
  id            String   @id @default(cuid())
  batchId       String
  email         String
  universityId  String
  originalId    String?
  name          String?
  isReAdmission Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([batchId])
  @@index([email])
  @@unique([batchId, universityId])
}

model TelegramNotification {
  id            String   @id @default(cuid())
  department    String
  type          String
  title         String
  message       String
  sentBy        String?
  sentAt        DateTime @default(now())
  recipientCount Int     @default(0)

  @@index([department])
  @@index([type])
}
